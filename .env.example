SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DATABASE_PROVIDER=supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plataforma_beco
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Em desenvolvimento com PostgreSQL, confirma o usuário sem enviar e-mail.
LOCAL_AUTH_AUTO_CONFIRM=true
PORT=3333
